---
import SectionHeading from '../common/SectionHeading.astro';
import { skills } from '../../config/cv.json';
---

<section id="skills" class="scroll-mt-20 py-10 sm:py-14 lg:py-16 bg-background-offset/40">
	<div class="container mx-auto px-4 max-w-6xl">
		<SectionHeading eyebrow="Toolkit" title="Technical Skills" />

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8">
			{skills.groups.map((group) => (
				<div>
					<p class="font-mono text-xs uppercase tracking-widest text-offset mb-3">
						{group.label}
					</p>
					<p class="text-xs leading-relaxed">
						{group.items.join(' · ')}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
