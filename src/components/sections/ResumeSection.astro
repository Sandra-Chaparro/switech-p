---
import { basic } from '../../config/cv.json';
---

<section id="resume" class="scroll-mt-20 py-10">
	<div class="container mx-auto px-4 max-w-5xl">
		<div class="p-8 sm:p-10 bg-background-offset border border-default rounded-2xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
			<div>
				<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-2">Résumé</p>
				<h2 class="text-2xl lg:text-3xl font-semibold mb-3">Get the full picture</h2>
				<p class="text-offset max-w-xl">
					{basic?.summary}
				</p>
			</div>
			<a href={`/cv/${basic?.cv_file_name}`} title="Download Résumé" download
				class="shrink-0 inline-flex items-center justify-center px-8 py-3.5 text-base text-white
					font-semibold transition-all duration-200 rounded
					bg-primary hover:bg-secondary focus:bg-secondary" role="button">
				Download Résumé (PDF)
			</a>
		</div>
	</div>
</section>
