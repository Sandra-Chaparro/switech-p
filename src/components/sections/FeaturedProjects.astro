---
import SectionHeading from '../common/SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../../config/cv.json';

import drTileImg from '../../assets/projects/dr-tile-solutions.jpg';
import mcBarberImg from '../../assets/projects/mc-the-barber.jpg';
import salvatierraImg from '../../assets/projects/salvatierra-digital.jpg';

const images: Record<string, ImageMetadata> = {
	'dr-tile-solutions.jpg': drTileImg,
	'mc-the-barber.jpg': mcBarberImg,
	'salvatierra-digital.jpg': salvatierraImg,
};

const clientProjects = projects.filter((p) => p.category === 'client');
const engineeringProjects = projects.filter((p) => p.category === 'engineering');
---

<section id="projects" class="scroll-mt-20 py-10 sm:py-14 lg:py-16 bg-background-offset/40">
	<div class="container mx-auto px-4 max-w-6xl">
		<SectionHeading
			eyebrow="Work"
			title="Featured Work"
			subtitle="A look at what I've built — from client-facing web products to full-stack software engineering work."
		/>

		<p class="font-mono text-xs uppercase tracking-widest text-offset mb-5">
			Web &amp; Client Projects
		</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{clientProjects.map((project) => (
				<ProjectCard
					title={project.title}
					type={project.type}
					description={project.description}
					tech={project.tech}
					repoUrl={project.repoUrl}
					liveUrl={project.liveUrl}
					image={project.image ? images[project.image] : undefined}
				/>
			))}
		</div>

		{engineeringProjects.length > 0 && (
			<>
				<p class="mt-14 font-mono text-xs uppercase tracking-widest text-offset mb-5">
					Software Engineering
				</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{engineeringProjects.map((project) => (
						<ProjectCard
							title={project.title}
							type={project.type}
							years={project.years}
							description={project.description}
							bullets={project.bullets}
							tech={project.tech}
							repoUrl={project.repoUrl}
							repoUrls={project.repoUrls}
							liveUrl={project.liveUrl}
						/>
					))}
				</div>
			</>
		)}
	</div>
</section>
