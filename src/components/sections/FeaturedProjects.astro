---
import SectionHeading from '../common/SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../../config/cv.json';

import drTileImg from '../../assets/projects/dr-tile-solutions.jpg';
import mcBarberImg from '../../assets/projects/mc-the-barber.jpg';
import salvatierraImg from '../../assets/projects/salvatierra-digital.jpg';

const images: Record<string, ImageMetadata> = {
	'dr-tile-solutions.jpg': drTileImg,
	'mc-the-barber.jpg': mcBarberImg,
	'salvatierra-digital.jpg': salvatierraImg,
};

const liveProjects = projects.filter((p) => p.image);
const otherProjects = projects.filter((p) => !p.image);
---

<section id="projects" class="scroll-mt-20 py-8 bg-background-offset/40">
	<div class="container mx-auto px-4 max-w-6xl">
		<SectionHeading
			eyebrow="Work"
			title="Featured Projects"
			subtitle="Live websites I designed and built end-to-end."
		/>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
			{liveProjects.map((project) => (
				<ProjectCard
					title={project.title}
					type={project.type}
					description={project.description}
					tech={project.tech}
					repoUrl={project.repoUrl}
					liveUrl={project.liveUrl}
					image={project.image ? images[project.image] : undefined}
				/>
			))}
		</div>

		{otherProjects.length > 0 && (
			<>
				<p class="mt-12 text-xs font-semibold uppercase tracking-widest text-offset mb-4">
					Other Projects
				</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					{otherProjects.map((project) => (
						<ProjectCard
							title={project.title}
							type={project.type}
							org={project.org}
							location={project.location}
							years={project.years}
							description={project.description}
							bullets={project.bullets}
							tech={project.tech}
							repoUrl={project.repoUrl}
							repoUrls={project.repoUrls}
							liveUrl={project.liveUrl}
						/>
					))}
				</div>
			</>
		)}
	</div>
</section>
