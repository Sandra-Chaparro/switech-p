---
import { Image } from 'astro:assets';
import heroImage from '../../assets/sandra_pic.jpg';
import { basic } from '../../config/cv.json';
---

<section class="py-4 px-4 sm:py-8 lg:py-12">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="grid items-center grid-cols-1 gap-10 lg:grid-cols-2">
            <div class="relative flex justify-center">
                <Image class="w-32 sm:w-44 md:w-56 lg:w-64 rounded-full object-cover"
                    src={heroImage}
                    loading="eager"
                    alt={`${basic?.name} — ${basic?.job}`} />
            </div>
            <div>
                <p class="text-lg text-offset">
                    {basic?.tagline || basic?.job}
                </p>

                <h1 class="text-2xl font-bold sm:text-3xl lg:text-4xl mt-3">
                    {basic?.name}
                </h1>

                <p class="mt-5 text-base sm:text-xl">
                    {basic?.summary}
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/#projects"
                        class="inline-flex items-center justify-center px-6 py-2.5 text-sm text-white
                            font-semibold transition-all duration-200 rounded
                            bg-primary hover:bg-secondary focus:bg-secondary" role="button">
                        View My Work
                    </a>
                    <a href={`/cv/${basic?.cv_file_name}`} title="Download Resume" download
                        class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold
                            transition-all duration-200 rounded border border-default
                            hover:bg-background-offset focus:bg-background-offset" role="button">
                        Download Resume
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
