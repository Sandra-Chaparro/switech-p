---
import { Image } from 'astro:assets';
import heroImage from '../../assets/sandra_pic.jpg';
import { basic, focusAreas } from '../../config/cv.json';
---

<section class="py-5 px-4 sm:py-10 lg:py-16">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="grid items-center grid-cols-1 gap-12 lg:grid-cols-2">
            <div class="relative flex justify-center">
                <Image class="w-40 sm:w-52 md:w-72 lg:w-80 rounded-full object-cover"
                    src={heroImage}
                    loading="eager"
                    alt={`${basic?.name} — ${basic?.job}`} />
            </div>
            <div>
                <p class="text-lg text-offset">
                    {basic?.tagline || basic?.job}
                </p>

                <h1 class="text-2xl font-bold sm:text-4xl lg:text-5xl mt-3">
                    {basic?.name}
                </h1>

                <p class="mt-5 text-base sm:text-xl">
                    {basic?.summary}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                    {focusAreas.map((area) => (
                        <span class="text-xs px-2.5 py-1 rounded-full bg-background-offset text-offset border border-default">
                            {area}
                        </span>
                    ))}
                </div>

                <div class="mt-8 flex flex-wrap gap-4">
                    <a href="/#projects"
                        class="inline-flex items-center justify-center px-8 py-3.5 text-base text-white
                            font-semibold transition-all duration-200 rounded
                            bg-primary hover:bg-secondary focus:bg-secondary" role="button">
                        View My Work
                    </a>
                    <a href="/#resume"
                        class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold
                            transition-all duration-200 rounded border border-default
                            hover:bg-background-offset focus:bg-background-offset" role="button">
                        Résumé
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
