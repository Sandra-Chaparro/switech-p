---
import { Image } from 'astro:assets';
import heroImage from '../../assets/sandra_pic.jpg';
import { basic } from '../../config/cv.json';
---

<section class="relative overflow-hidden py-10 sm:py-14 lg:py-16">
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0"
        style="background-image: radial-gradient(var(--color-border) 1px, transparent 1px); background-size: 26px 26px; -webkit-mask-image: radial-gradient(ellipse 60% 60% at 75% 30%, black, transparent); mask-image: radial-gradient(ellipse 60% 60% at 75% 30%, black, transparent);"
    ></div>

    <div class="relative px-4 mx-auto max-w-6xl sm:px-6 lg:px-8">
        <div class="grid items-center grid-cols-1 gap-12 lg:grid-cols-2">
            <div class="relative flex justify-center order-first">
                <Image class="w-28 sm:w-36 md:w-44 lg:w-48 rounded-full object-cover ring-4 ring-primary shadow-lg"
                    src={heroImage}
                    loading="eager"
                    alt={`${basic?.name} — ${basic?.job}`} />
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">
                    {basic?.name}
                </h1>

                <p class="mt-3 text-base sm:text-lg font-semibold text-primary">
                    {basic?.tagline || basic?.job}
                </p>

                <p class="mt-5 text-xs sm:text-sm text-offset leading-relaxed max-w-xl">
                    {basic?.summary}
                </p>

                <div class="mt-9 flex flex-wrap gap-3">
                    <a href="/#projects"
                        class="inline-flex items-center justify-center px-4 py-2 text-xs text-white
                            font-semibold transition-all duration-200 rounded
                            bg-primary hover:bg-secondary focus:bg-secondary" role="button">
                        View My Work
                    </a>
                    <a href={`/cv/${basic?.cv_file_name}`} title="Download Résumé" download
                        class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold
                            transition-all duration-200 rounded border border-default
                            hover:bg-background-offset focus:bg-background-offset" role="button">
                            Download Resume
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
