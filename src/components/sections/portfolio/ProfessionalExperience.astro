---
import SectionHeading from '../../common/SectionHeading.astro';
import CardListSection from './CardListSection.astro';
import { experiences } from '../../../config/cv.json';

const items = experiences.map((exp) => ({
	title: exp.title,
	sub_title: `${exp.company} · ${exp.location}`,
	years: exp.years,
	bullets: exp.bullets,
	tech: exp.tech,
}));
---

<section id="experience" class="scroll-mt-20 py-10">
	<div class="container mx-auto px-4 max-w-5xl">
		<SectionHeading
			eyebrow="Career"
			title="Professional Experience"
			subtitle="Full-stack engineering work across healthcare, government-adjacent, and client-facing products."
		/>
		<CardListSection items={items} />
	</div>
</section>
