---
interface Props {
	title: string;
	sub_title: string;
	years: string;
	bullets?: string[];
	tech?: string[];
}

const { title, sub_title, years, bullets, tech } = Astro.props;
---

<li class="relative pl-7">
  <span class="absolute -left-[5px] top-1.5 h-2 w-2 rounded-full bg-primary ring-4 ring-background"></span>

  <div class="p-4 bg-background-offset shadow-lg rounded-xl border border-default transition-shadow duration-200 hover:shadow-xl hover:border-primary/30">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1 sm:gap-4">
      <div>
        <h3 class="text-xs sm:text-sm font-semibold">{title}</h3>
        <p class="text-sm font-medium text-primary mt-0.5">{sub_title}</p>
      </div>
      <p class="font-mono text-xs text-offset sm:text-right whitespace-nowrap">{years}</p>
    </div>

    {bullets && bullets.length > 0 && (
      <ul class="mt-4 space-y-2 text-xs text-offset leading-relaxed list-disc list-outside ml-4">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}

    {tech && tech.length > 0 && (
      <p class="mt-4 font-mono text-xs text-offset/80 tracking-tight">
        {tech.join(' · ')}
      </p>
    )}
  </div>
</li>
