---
const { title, sub_title, years, details } = Astro.props;
---

<li class="p-3 bg-background-offset shadow-lg rounded-xl border border-default">
  <div class="flex flex-col sm:flex-row justify-between items-start">
    <div class="mb-2 sm:mb-0">
      <h3 class="text-lg font-semibold">{title}</h3>
      <p class="text-sm font-medium text-secondary pt-1">{sub_title}</p>
    </div>
    <p class="text-xs text-offset sm:text-right whitespace-nowrap">{years}</p>
  </div>
  <p class="mt-2 text-sm text-offset leading-relaxed">{details}</p>
</li>
