---
interface Props {
	title: string;
	sub_title: string;
	years: string;
	bullets?: string[];
	tech?: string[];
}

const { title, sub_title, years, bullets, tech } = Astro.props;
---

<li class="p-5 bg-background-offset shadow-lg rounded-xl border border-default">
  <div class="flex flex-col sm:flex-row justify-between items-start">
    <div class="mb-2 sm:mb-0">
      <h3 class="text-lg font-semibold">{title}</h3>
      <p class="text-sm font-medium text-secondary pt-1">{sub_title}</p>
    </div>
    <p class="text-xs text-offset sm:text-right whitespace-nowrap">{years}</p>
  </div>

  {bullets && bullets.length > 0 && (
    <ul class="mt-3 space-y-1.5 text-sm text-offset leading-relaxed list-disc list-outside ml-4">
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  )}

  {tech && tech.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tech.map((item) => (
        <span class="text-xs px-2 py-1 rounded-full bg-background text-offset border border-default">
          {item}
        </span>
      ))}
    </div>
  )}
</li>
