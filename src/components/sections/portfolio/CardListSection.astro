---
import CardListItem from './CardListItem.astro';

interface Item {
  title: string;
  sub_title: string;
  years: string;
  bullets?: string[];
  tech?: string[];
}

const { items } = Astro.props;
---

<ul class="space-y-4">
  {items.map((item: Item) => (
    <CardListItem
      title={item.title}
      sub_title={item.sub_title}
      years={item.years}
      bullets={item?.bullets}
      tech={item?.tech}
    />
  ))}
</ul>
