---
import { contact } from '../../config/cv.json';

const linkedinUrl = contact.socialLinks.find((s) => s.label === 'LinkedIn')?.link;
---

<form
	id="contact-form"
	name="contact"
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	class="space-y-5"
>
	<input type="hidden" name="form-name" value="contact" />
	<p class="hidden">
		<label>
			Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
		</label>
	</p>

	<div>
		<label for="name" class="block text-sm font-medium mb-1.5">Name</label>
		<input
			type="text"
			name="name"
			id="name"
			required
			class="w-full px-3.5 py-2 rounded-lg bg-default border border-default text-default
				focus:outline-none focus:ring-2 focus:ring-primary"
		/>
	</div>

	<div>
		<label for="email" class="block text-sm font-medium mb-1.5">Email</label>
		<input
			type="email"
			name="email"
			id="email"
			required
			class="w-full px-3.5 py-2 rounded-lg bg-default border border-default text-default
				focus:outline-none focus:ring-2 focus:ring-primary"
		/>
	</div>

	<div>
		<label for="message" class="block text-sm font-medium mb-1.5">Message</label>
		<textarea
			name="message"
			id="message"
			rows="5"
			required
			class="w-full px-3.5 py-2 rounded-lg bg-default border border-default text-default
				focus:outline-none focus:ring-2 focus:ring-primary"
		></textarea>
	</div>

	<button
		id="contact-submit"
		type="submit"
		class="inline-flex items-center justify-center px-4 py-2 text-xs text-white
			font-semibold transition-all duration-200 rounded
			bg-primary hover:bg-secondary focus:bg-secondary"
	>
		Send Message
	</button>

	<!-- Temporary: form submission not ready yet -->
	<p id="contact-status" role="status" aria-live="polite" class="hidden text-sm text-default">
		Unable to submit, please send me a DM on
		<a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-primary underline">Linkedin</a>
	</p>
</form>

<script>
	// Temporary: block submission until the contact form is ready.
	const form = document.getElementById('contact-form');
	const button = document.getElementById('contact-submit');
	const status = document.getElementById('contact-status');

	button?.addEventListener('click', (e) => {
		e.preventDefault();
		status?.classList.remove('hidden');
	});
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		status?.classList.remove('hidden');
	});
</script>
