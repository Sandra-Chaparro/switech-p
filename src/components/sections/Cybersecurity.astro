---
import SectionHeading from '../common/SectionHeading.astro';
import CertItem from './CertItem.astro';
import { cybersecurityHighlights, certifications, focusAreas } from '../../config/cv.json';
---

<section id="cybersecurity" class="scroll-mt-20 py-10">
	<div class="container mx-auto px-4 max-w-5xl">
		<SectionHeading
			eyebrow="Transition"
			title="Cybersecurity"
			subtitle="I'm a software engineer building focused expertise in cybersecurity — grounded in real application security work, and growing into threat intelligence, OSINT, threat hunting, and AI security through certification study and continued learning."
		/>

		<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-3">
			Focus Areas
		</p>
		<div class="flex flex-wrap gap-2 mb-10">
			{focusAreas.map((area) => (
				<span class="text-sm px-3 py-1.5 rounded-full bg-background-offset text-offset border border-default">
					{area}
				</span>
			))}
		</div>

		<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-3">
			Applied Security Work
		</p>
		<ul class="space-y-2.5 text-sm sm:text-base text-offset leading-relaxed list-disc list-outside ml-5 mb-10">
			{cybersecurityHighlights.map((item) => <li>{item}</li>)}
		</ul>

		<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-4">
			Certifications &amp; Credentials
		</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			{certifications.map((cert) => (
				<CertItem
					name={cert.name}
					issuer={cert.issuer}
					status={cert.status}
					note={cert.note}
					fileName={cert.fileName}
					credentialUrl={cert.credentialUrl}
				/>
			))}
		</div>
	</div>
</section>
