---
import { Icon } from 'astro-icon/components';
import SectionHeading from '../common/SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import { contact } from '../../config/cv.json';

const links = (contact?.socialLinks ?? []).filter((s) => s.link);
---

<section id="contact" class="scroll-mt-20 py-10 bg-background-offset/40">
	<div class="container mx-auto px-4 max-w-5xl">
		<SectionHeading
			eyebrow="Get in touch"
			title="Contact"
			subtitle="Have a role, project, or opportunity in mind? Send a message and I'll get back to you."
		/>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
			<div class="lg:col-span-2">
				<ContactForm />
			</div>

			{links.length > 0 && (
				<div class="space-y-3">
					<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-2">
						Find me elsewhere
					</p>
					{links.map((social) => (
						<a
							href={social.link}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-3 p-3 bg-background-offset border border-default rounded-lg hover:bg-background transition-colors"
						>
							<Icon name={social.iconName} class="size-5" />
							<span class="text-sm font-medium">{social.label}</span>
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</section>
