---
import SectionHeading from '../common/SectionHeading.astro';
import { basic } from '../../config/cv.json';
---

<section id="resume" class="scroll-mt-20 py-10 sm:py-14 lg:py-16">
	<div class="container mx-auto px-4 max-w-6xl text-center">
		<SectionHeading
			eyebrow="Evidence"
			title="Full Resume"
			subtitle="For the complete breakdown of roles, responsibilities, and technologies, download the full resume."
			center
		/>

		<a href={`/cv/${basic?.cv_file_name}`} title="Download Résumé" download
			class="inline-flex items-center justify-center px-4 py-2 text-xs text-white
				font-semibold transition-all duration-200 rounded
				bg-primary hover:bg-secondary focus:bg-secondary" role="button">
			Download Resume →
		</a>
	</div>
</section>
