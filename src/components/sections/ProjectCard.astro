---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	type?: string;
	org?: string;
	location?: string;
	years?: string;
	description?: string;
	bullets?: string[];
	tech?: string[];
	repoUrl?: string;
	repoUrls?: { label: string; url: string }[];
	liveUrl?: string;
	image?: ImageMetadata;
}

const { title, type, org, location, years, description, bullets, tech, repoUrl, repoUrls, liveUrl, image } = Astro.props;
---

<div class="group flex flex-col h-full bg-background-offset border border-default rounded-xl shadow-lg overflow-hidden transition-shadow duration-200 hover:shadow-xl hover:border-primary/30">
	{image && (
		<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="block aspect-video overflow-hidden border-b border-default bg-background">
			<Image
				src={image}
				alt={`Screenshot of the ${title} website`}
				class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
				widths={[500, 900]}
				sizes="(min-width: 1024px) 560px, 100vw"
			/>
		</a>
	)}

	<div class="flex flex-col flex-grow p-4">
		<div class="flex items-start justify-between gap-3">
			<div>
				<h3 class="text-sm font-semibold">{title}</h3>
				{type && (
					<p class="text-xs font-medium text-secondary pt-1">{type}</p>
				)}
				{!type && (org || location) && (
					<p class="text-xs font-medium text-secondary pt-1">
						{org}{org && location ? " · " : ""}{location}
					</p>
				)}
			</div>
			{!image && (
				<div class="shrink-0 w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path stroke="none" d="M0 0h24v24H0z" fill="none" />
						<path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-14z" />
						<path d="M7 8l2 2l-2 2" />
						<path d="M12 12l4 0" />
					</svg>
				</div>
			)}
		</div>
		{years && <p class="text-xs text-offset mt-1">{years}</p>}

		{description && (
			<p class="mt-3 text-xs text-offset leading-relaxed flex-grow">{description}</p>
		)}

		{!description && bullets && bullets.length > 0 && (
			<ul class="mt-4 space-y-1.5 text-xs text-offset leading-relaxed list-disc list-outside ml-4 flex-grow">
				{bullets.map((bullet) => <li>{bullet}</li>)}
			</ul>
		)}

		{tech && tech.length > 0 && (
			<p class="mt-4 font-mono text-xs text-offset/80 tracking-tight">
				{tech.join(' · ')}
			</p>
		)}

		{repoUrls && repoUrls.length > 0 ? (
			<div class="mt-5 flex flex-wrap gap-3 pt-4 border-t border-default">
				{repoUrls.map((repo) => (
					<a href={repo.url} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
						{repo.label} →
					</a>
				))}
				{liveUrl && (
					<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
						Live Demo →
					</a>
				)}
			</div>
		) : (
			<>
				{liveUrl && !repoUrl && (
					<div class="mt-5 pt-4 border-t border-default">
						<a href={liveUrl} target="_blank" rel="noopener noreferrer"
							class="inline-flex items-center justify-center px-4 py-2 text-sm text-white
								font-semibold transition-all duration-200 rounded
								bg-primary hover:bg-secondary focus:bg-secondary">
							View Project →
						</a>
					</div>
				)}

				{repoUrl && !liveUrl && (
					<div class="mt-5 pt-4 border-t border-default">
						<a href={repoUrl} target="_blank" rel="noopener noreferrer"
							class="inline-flex items-center justify-center px-4 py-2 text-sm text-white
								font-semibold transition-all duration-200 rounded
								bg-primary hover:bg-secondary focus:bg-secondary">
							View Repo →
						</a>
					</div>
				)}

				{(repoUrl && liveUrl) && (
					<div class="mt-5 flex gap-3 pt-4 border-t border-default">
						<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
							View Repo →
						</a>
						<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
							Live Demo →
						</a>
					</div>
				)}
			</>
		)}
	</div>
</div>
