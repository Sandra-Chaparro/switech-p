---
interface Props {
	name: string;
	issuer: string;
	status: string;
	note?: string;
	fileName?: string;
	credentialUrl?: string;
}

const { name, issuer, status, note, fileName, credentialUrl } = Astro.props;

const statusClasses: Record<string, string> = {
	Completed: "bg-success-bg text-success",
	"In Progress": "bg-warning-bg text-warning",
};
---

<div class="p-5 bg-background-offset border border-default rounded-xl">
	<div class="flex items-start justify-between gap-3">
		<div>
			<h3 class="text-base font-semibold">{name}</h3>
			<p class="text-sm text-offset mt-0.5">{issuer}</p>
		</div>
		<span class={`shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${statusClasses[status]}`}>
			{status}
		</span>
	</div>

	{note && <p class="text-xs text-offset mt-3 leading-relaxed">{note}</p>}

	{(fileName || credentialUrl) && (
		<div class="mt-4 flex gap-4 pt-3 border-t border-default">
			{credentialUrl && (
				<a href={credentialUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
					View Credential →
				</a>
			)}
			{fileName && (
				<a href={`/certs/${fileName}`} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary hover:text-secondary">
					Download PDF →
				</a>
			)}
		</div>
	)}
</div>
