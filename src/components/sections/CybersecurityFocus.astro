---
import SectionHeading from '../common/SectionHeading.astro';
import CertItem from './CertItem.astro';
import { roadmap, certifications } from '../../config/cv.json';
---

<section id="cybersecurity-focus" class="scroll-mt-20 py-10 sm:py-14 lg:py-16 bg-background-offset/40">
	<div class="container mx-auto px-4 max-w-6xl">
		<SectionHeading
			eyebrow="Roadmap"
			title="Career Roadmap"
			subtitle="How my career is progressing toward cybersecurity — from a software engineering foundation, through formal security study and hands-on exploration, to a cybersecurity role."
		/>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
			{roadmap.map((step) => (
				<div class="p-4 bg-background border border-default rounded-xl transition-shadow duration-200 hover:shadow-lg hover:border-primary/30">
					<p class="font-mono text-2xl font-bold text-primary/40">{step.stage}</p>
					<p class="text-sm font-semibold mt-2">{step.title}</p>
					<p class="text-xs text-offset leading-relaxed mt-2">{step.description}</p>
				</div>
			))}
		</div>

		<p class="font-mono text-xs uppercase tracking-widest text-offset mb-4">
			Supporting Certifications &amp; Training
		</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{certifications.map((cert) => (
				<CertItem
					name={cert.name}
					issuer={cert.issuer}
					status={cert.status}
					note={cert.note}
					fileName={cert.fileName}
					credentialUrl={cert.credentialUrl}
				/>
			))}
		</div>
	</div>
</section>
