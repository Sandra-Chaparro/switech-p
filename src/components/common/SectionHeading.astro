---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class={`mb-6 sm:mb-8 ${center ? "text-center mx-auto" : ""}`}>
	{eyebrow && (
		<p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-primary mb-3">
			{eyebrow}
		</p>
	)}
	<h2 class="text-lg sm:text-xl font-bold tracking-tight">{title}</h2>
	{subtitle && (
		<p class={`mt-4 text-xs sm:text-sm text-offset leading-relaxed max-w-2xl ${center ? "mx-auto" : ""}`}>
			{subtitle}
		</p>
	)}
</div>
