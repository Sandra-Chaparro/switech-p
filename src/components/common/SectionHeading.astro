---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class={`mb-8 ${center ? "text-center mx-auto" : ""}`}>
	{eyebrow && (
		<p class="text-xs font-semibold uppercase tracking-widest text-offset mb-2">
			{eyebrow}
		</p>
	)}
	<h2 class="text-2xl lg:text-3xl font-semibold">{title}</h2>
	{subtitle && (
		<p class={`mt-3 text-offset max-w-2xl ${center ? "mx-auto" : ""}`}>
			{subtitle}
		</p>
	)}
</div>
